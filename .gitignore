# Environment & Security
.env
.env.local
certs/

# Data Directories — source data files are NEVER committed (only manifests)
data/source/
data/staging/
*.csv
*.xlsx
*.xls

# Manifests ARE committed (checksums/metadata only, no raw data)
!data/manifests/
!data/manifests/*.yaml

# Python Virtual Environments & Packages
venv/
ENV/
env/
*.egg-info/
build/
dist/

# Byte-compiled / Optimized / Caches
__pycache__/
*.pyc
*.pyo
*.pyd

# SQLite Databases (Forbidden — cloud-native platform)
*.db
*.sqlite
*.sqlite3

# Tool Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Schema snapshot disk cache (auto-generated, process-level speedup)
src/pwa/agent/.schema_cache/


.agents/
.claude/
.streamlit/
.coverage
*.sync_state.json
.sync_state.json