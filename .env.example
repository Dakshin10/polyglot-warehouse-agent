KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Aiven MySQL
# MYSQL_PORT must be the five-digit Aiven port; 3306 is rejected.
# MYSQL_SSL_CA must point at a file that exists: download the service CA from
# the Aiven console (service -> Overview -> CA certificate). Validation fails
# if it is missing, because without it the server's identity is unverified.
MYSQL_HOST=mysql-xxxxxxx-yourproject.a.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_mysql_password
MYSQL_DB=movie_registry
MYSQL_SSL_CA=./certs/ca.pem

# Cloud SQL PostgreSQL
# PG_CONNECT_MODE is "connector" or "direct". In direct mode PG_HOST is required.
PG_CONNECT_MODE=connector
PG_HOST=
PG_PORT=5432
PG_USER=loader
PG_PASSWORD=your_cloud_sql_postgres_password
PG_DB=movie_credits
PG_INSTANCE_CONNECTION_NAME=project:europe-west1:movie-credits

# BigQuery
# BQ_LOCATION must be the Cloud SQL region above, or the multi-region that
# covers it (europe-west* -> EU, us-* -> US). A mismatch surfaces later as a
# "not found" error that never mentions location.
GCP_PROJECT=your-gcp-project-id
BQ_LOCATION=EU
BQ_CONNECTION_ID=movie-credits-conn
PG_BQ_READER_USER=bqreader
PG_BQ_READER_PASSWORD=your_bqreader_password
BQ_DS_REGISTRY=raw_registry
BQ_DS_CREDITS=raw_credits
BQ_DS_FILES=raw_files
BQ_DS_MART=mart
