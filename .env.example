# =============================================================================
# Nexora Technologies — Polyglot Warehouse Agent (.env.example)
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is listed in .gitignore.
# =============================================================================

# Kaggle credentials (required for dataset download)
# Get your API token from: https://www.kaggle.com/settings → API → Create Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# =============================================================================
# Google Cloud Platform (required)
# =============================================================================

GCP_PROJECT=your-gcp-project-id

# BigQuery location — must be a valid BQ multi-region or region.
# EU covers europe-west* regions. US covers us-* regions.
BQ_LOCATION=EU

# =============================================================================
# BigQuery Dataset Names — Raw Layer (source-preserving)
# =============================================================================
BQ_DS_RAW_AW=raw_adventureworks
BQ_DS_RAW_OLIST=raw_olist
BQ_DS_RAW_MARKETING=raw_olist_marketing

# =============================================================================
# BigQuery Dataset Names — Staging Layer (normalized)
# =============================================================================
BQ_DS_STAGING_ENT=staging_enterprise
BQ_DS_STAGING_MKT=staging_marketplace

# =============================================================================
# BigQuery Dataset Names — Curated Layer (canonical enterprise model)
# =============================================================================
BQ_DS_CURATED_ENT=curated_enterprise
BQ_DS_CURATED_MKT=curated_marketplace

# =============================================================================
# BigQuery Dataset Names — Control Plane
# =============================================================================
BQ_DS_METADATA=pwa_metadata
BQ_DS_ROLLUP=rollup

# =============================================================================
# Google ADK & LLM Agent Settings
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key
GOOGLE_GENAI_USE_VERTEXAI=0

# Model selection (global or per-stage)
# PWA_AGENT_MODEL: global override ("gemini" or "groq")
PWA_AGENT_MODEL=
PWA_AGENT_SCHEMA_MODEL=groq
PWA_AGENT_SQL_MODEL=gemini
PWA_AGENT_ANSWER_MODEL=groq

# =============================================================================
# Guardrails & Timeouts
# =============================================================================
PWA_AGENT_TIMEOUT_SECONDS=30
PWA_AGENT_MAX_QUERIES_PER_MIN=20
PWA_AGENT_MAX_BYTES_SCANNED=1000000000

# =============================================================================
# Alerting & Notification Sinks (Slack / PagerDuty)
# =============================================================================
# PWA_SLACK_WEBHOOK_URL: Incoming Webhook URL from Slack Apps (https://api.slack.com/messaging/webhooks)
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
PWA_SLACK_WEBHOOK_URL=

# PWA_PAGERDUTY_ROUTING_KEY: Integration Key for PagerDuty Events API v2 (https://support.pagerduty.com/docs/services-and-integrations)
# Example: 328c465d6480459d87e0766a59892c90
PWA_PAGERDUTY_ROUTING_KEY=

# PWA_ALERTING_STRICT: Set to 1 to fail startup if alerting credentials are missing
PWA_ALERTING_STRICT=0


# =============================================================================
# Optional: Local path overrides
# =============================================================================
# PWA_SOURCE_BASE_DIR=data/source
# PWA_MANIFEST_DIR=data/manifests

# =============================================================================
# Optional: Aiven MySQL (not required for primary ingestion pipeline)
# Only needed if using MySQL as a live-source connector.
# MYSQL_PORT must be the five-digit Aiven port; 3306 is rejected.
# MYSQL_SSL_CA must point to the Aiven service CA certificate file.
# =============================================================================
# MYSQL_HOST=mysql-xxxxxxx-yourproject.a.aivencloud.com
# MYSQL_PORT=12345
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_aiven_mysql_password
# MYSQL_DB=nexora_erp
# MYSQL_SSL_CA=./certs/ca.pem

# =============================================================================
# Optional: Cloud SQL PostgreSQL (not required for primary ingestion pipeline)
# Only needed if using PostgreSQL as a live-source connector.
# PG_CONNECT_MODE: "connector" (Cloud SQL Auth Proxy) or "direct" (IP).
# =============================================================================
# PG_CONNECT_MODE=connector
# PG_HOST=
# PG_PORT=5432
# PG_USER=loader
# PG_PASSWORD=your_cloud_sql_postgres_password
# PG_DB=nexora_marketplace
# PG_INSTANCE_CONNECTION_NAME=project:region:instance
# BQ_CONNECTION_ID=nexora-source-conn
# PG_BQ_READER_USER=bqreader
# PG_BQ_READER_PASSWORD=your_bqreader_password
